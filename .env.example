# Copie este arquivo para .env e preencha os valores localmente.
# Nunca versionar .env, tokens, chaves privadas ou service accounts.
# Configuração Firebase no cliente é pública (EXPO_PUBLIC_*), mas Admin SDK fica só na API.

# URL base da API autotrack-api (ambiente local ou remoto)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Ambiente da aplicação (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Quando true, se a API estiver indisponível o app usa perfil mock após login Firebase
EXPO_PUBLIC_API_MOCK=true

# Firebase Web App (Console → Project settings → Your apps → Web </> )
# Use SOMENTE o objeto firebaseConfig do app Web.
# apiKey começa com AIza… — NÃO cole chave privada / service account / PEM.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx

# Google Sign-In (OAuth client IDs do mesmo projeto Firebase / Google Cloud)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Tooling local Notion (ATP-34) — NÃO usar no app Expo / NÃO prefixar EXPO_PUBLIC_ ---
# Token da integração Notion (Settings → Connections / my-integrations). Nunca versionar o valor.
# NOTION_TOKEN=
# ID do database do board Mobile (URL do database ou Share → copy link).
# NOTION_DATABASE_ID=
# Opcionais (defaults no scripts/notion/config.mjs):
# NOTION_PROP_TASK_ID=ID da Task
# NOTION_PROP_STATUS=Status
# NOTION_PROP_TYPE=Tipo
# NOTION_BASE_BRANCH=master
# NOTION_EXPECTED_REPO=autotrack-mobile
