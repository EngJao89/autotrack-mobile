# Copie este arquivo para .env e preencha os valores localmente.
# Nunca versionar .env, tokens, chaves ou credenciais.
# Configuração Firebase no cliente é pública (EXPO_PUBLIC_*), mas Admin SDK fica só na API.

# URL base da API autotrack-api (ambiente local ou remoto)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Ambiente da aplicação (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Quando true, se a API estiver indisponível o app usa perfil mock após login Firebase
EXPO_PUBLIC_API_MOCK=true

# Firebase Web App (Console → Project settings → Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (OAuth client IDs do mesmo projeto Firebase / Google Cloud)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
